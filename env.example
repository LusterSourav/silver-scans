# Silver Scan Platform Environment Variables

# Core Services
VT_API_KEY=your_virustotal_api_key
MOBSF_API_KEY=generate_with_openssl_rand_hex_32
SECRET_KEY=generate_with_openssl_rand_hex_32
REDIS_URL=redis://redis:6379/0
MONGO_URL=mongodb://mongo:27017
MONGO_DB=forensics

# Living Threat Intelligence Platform
POSTGRES_PASSWORD=living_intel_secure_password

# VirusTotal API (https://www.virustotal.com/gui/my-apikey)
VT_API_KEY=your_virustotal_api_key

# AlienVault OTX API (https://otx.alienvault.com/api)
OTX_API_KEY=your_otx_api_key

# GitHub Token (for GitHub Advisories)
GITHUB_TOKEN=your_github_token

# MISP Instance (if you have one)
MISP_URL=https://your-misp-instance.com
MISP_KEY=your_misp_auth_key

# OpenCTI Instance (if you have one)
OPENCTI_URL=https://your-opencti-instance.com
OPENCTI_TOKEN=your_opencti_token

# TAXII Server (if you have one)
TAXII_URL=https://your-taxii-server.com/taxii2
TAXII_USER=your_taxii_username
TAXII_PASS=your_taxii_password

# MaxMind GeoIP (https://www.maxmind.com/en/geolite2/signup)
MAXMIND_ACCOUNT_ID=your_maxmind_account_id
MAXMIND_LICENSE_KEY=your_maxmind_license_key

# Hybrid Analysis / Falcon Sandbox (https://www.hybrid-analysis.com/)
HYBRID_ANALYSIS_API_KEY=your_hybrid_analysis_api_key

# GreyNoise (https://www.greynoise.io/)
GREYNOISE_API_KEY=your_greynoise_api_key

# Shodan (https://account.shodan.io/)
SHODAN_API_KEY=your_shodan_api_key

# PassiveTotal / RiskIQ (https://www.riskiq.com/)
PASSIVETOTAL_USERNAME=your_passivetotal_username
PASSIVETOTAL_API_KEY=your_passivetotal_api_key

# Logging
LOG_LEVEL=INFO